{
  "name": "velox-markdown-studio",
  "version": "1.0.0",
  "description": "Windows-native Markdown Studio to open, preview, edit, and save MD files",
  "author": "Velox Studio",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.12.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite --port=3000",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "node -e \"const fs=require('node:fs');for(const d of ['dist','release','dev-dist'])fs.rmSync(d,{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "electron:dev": "electron .",
    "electron:build": "npm run build && electron-builder --win"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.veloxmd.studio",
    "productName": "Velox Markdown Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*"
    ],
    "win": {
      "icon": "public/favicon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    }
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "dompurify": "^3.4.16",
    "highlight.js": "^11.12.0",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^0.546.0",
    "marked": "^18.0.14",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0"
  }
}
